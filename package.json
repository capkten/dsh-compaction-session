{
  "name": "dsh-compaction-session",
  "description": "Session reasoning and absolute token thresholds for DSH 0.2.2 compaction",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capkten/dsh-compaction-session.git"
  },
  "homepage": "https://github.com/capkten/dsh-compaction-session#readme",
  "bugs": {
    "url": "https://github.com/capkten/dsh-compaction-session/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./settings": "./lib/settings.js"
  },
  "files": [
    "lib/*.js",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "INSTALL.md",
    "UPSTREAM.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "dependencies": {},
  "dshLocalRepair": {
    "base": "0.2.1-rc.5",
    "sourceSha256": "b7ac52f20a36430cf01a66b3a36f23a48ffdb22708d714dbe1fff541b5df4ec5",
    "changes": [
      "inherit-session-reasoning",
      "absolute-compaction-threshold",
      "reserve-summary-output"
    ]
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check src/index.js && node --check src/settings.js",
    "test": "node --test tests/repair.test.mjs"
  }
}
